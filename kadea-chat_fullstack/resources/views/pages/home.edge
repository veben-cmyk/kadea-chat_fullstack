@layouts.base({
  title: 'Bienvenue'
}) 
  
  

{{--
|--------------------------------------------------------------------------
| pages/home.edge : page d'accueil (visiteur non connecté)
|--------------------------------------------------------------------------
| Route : GET /   (nom : home)
| Aucune donnée dynamique : c'est une page statique avec 2 boutons.
--}}
  <main class="flex min-h-dvh flex-col items-center bg-brand-950 px-6 text-center text-white">

    <div class="flex flex-1 flex-col items-center justify-center py-12">
      @!ui.logo({ size: 'xl', withText: true })

      <h1 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight md:text-5xl">
        Connecter les idées, rapprocher les apprenants, accélérer la collaboration.
      </h1>

      <p class="mt-6 max-w-xl text-sm text-white/70 md:text-base">
        Une plateforme de messagerie fluide, minimaliste et sécurisée conçue exclusivement pour les apprenants de Kadea.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        @ui.button({ href: route('login.show'), variant: 'light' })
          Se connecter
        @end
        @ui.button({ href: route('register.store') })
          Créer un compte
        @end
      </div>
    </div>

    <footer class="py-6 text-xs text-white/70">
      Kadea.Chat — by Isaac Veben · 2026
    </footer>
  </main>
@end
