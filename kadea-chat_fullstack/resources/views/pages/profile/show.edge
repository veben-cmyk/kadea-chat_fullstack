{{--
|--------------------------------------------------------------------------
| pages/profile/show.edge : mon profil
|--------------------------------------------------------------------------
| Routes : GET /profile (profile.show), POST /profile (profile.update),
|          POST /profile/password (profile.password), POST /logout (logout)
| Données : profileUser (l'utilisateur connecté)
|
| Chaque formulaire a son propre bouton et sa propre route : une erreur dans
| l'un n'efface pas ce que tu as tapé dans l'autre.
--}}
@layouts.base({ title: 'Mon profil' })
  <div class="mx-auto w-full max-w-xl space-y-6 px-4 py-8">
    <a href="{{ route('chat.index') }}" class="text-sm font-bold text-brand-600 hover:underline">
      ← Retour aux discussions
    </a>

    <h1 class="font-display text-2xl font-bold">Mon profil</h1>

   <section class="rounded-2xl bg-white p-6 text-center shadow-sm">
  <div class="relative mx-auto h-28 w-28">
    @!ui.avatar({ name: profileUser.fullName, url: profileUser.avatarUrl, size: 'lg', class: 'ring-4 ring-brand-100' })

    <label for="avatar-file" class="absolute bottom-0 animate-pulse right-0 flex h-6 w-6 cursor-pointer items-center justify-center rounded-full bg-emerald-500  text-white shadow-md ring-2 ring-white hover:opacity-90" title="Changer la photo de profil" >
      @!ui.icon({ name: 'camera', class: 'h-5 w-5' })
      <span class="sr-only">Changer la photo de profil</span>
    </label>
    <input id="avatar-file" type="file" accept="image/png,image/jpeg,image/webp" class="sr-only" data-avatar-input>
  </div>

  <p class="mt-3 truncate font-display text-lg font-bold">{{ profileUser.fullName }}</p>
  {{-- L'e-mail est affiché mais non modifiable : le changer demanderait une nouvelle confirmation --}}
  <p class="truncate text-sm text-brand-600">{{ profileUser.email }}</p>
  <p class="mt-2 hidden text-xs text-brand-600" data-avatar-status role="status"></p>

  {{-- Formulaire caché : app.js y met l'adresse de la photo envoyée à Cloudinary, puis l'envoie --}}
  <form id="avatar-form" method="POST" action="{{ route('profile.avatar') }}" class="hidden">
    {{ csrfField() }}
    <input type="hidden" name="avatarUrl" data-avatar-url>
  </form>

  @if(profileUser.avatarUrl)
    <form method="POST" action="{{ route('profile.avatar.destroy') }}" class="mt-2">
      {{ csrfField() }}
      <button type="submit" class="text-xs text-red-600 hover:underline">Supprimer la photo</button>
    </form>
  @end
</section>

    {{-- Informations : modifier le nom --}}
<section class="rounded-2xl bg-white p-5 shadow-sm" aria-labelledby="info-title">
  <h2 id="info-title" class="mb-3 font-display text-base font-bold">Informations</h2>

  <form method="POST" action="{{ route('profile.update') }}" data-loading novalidate class="space-y-4">
    {{ csrfField() }}

    @!ui.input({ name: 'fullName', label: 'Nom complet', autocomplete: 'name', required: true, value: profileUser.fullName })

    @ui.button({ loadingText: 'Enregistrement...', class: 'w-full' })
      Enregistrer
    @end
  </form>
</section>

    {{-- Mot de passe --}}
    <section class="rounded-2xl bg-white p-5 shadow-sm" aria-labelledby="password-title">
      <h2 id="password-title" class="mb-3 font-display text-base font-bold">Mot de passe</h2>
      <form method="POST" action="{{ route('profile.password') }}" data-loading novalidate class="space-y-4">
        {{ csrfField() }}
        @!ui.input({ name: 'currentPassword', label: 'Mot de passe actuel', type: 'password', autocomplete: 'current-password', required: true })
        @!ui.input({ name: 'password', label: 'Nouveau mot de passe', type: 'password', autocomplete: 'new-password', required: true })
        @!ui.input({ name: 'password_confirmation', label: 'Confirmez le nouveau mot de passe', type: 'password', autocomplete: 'new-password', required: true })
        @ui.button({ loadingText: 'Modification...', class: 'w-full' })
          Changer le mot de passe
        @end
      </form>
    </section>

    {{-- Déconnexion --}}
    <section class="rounded-2xl bg-white p-5 shadow-sm">
      <form method="POST" action="{{ route('logout') }}">
        {{ csrfField() }}
        <button type="submit" class="w-full rounded-lg border border-red-300 px-4 py-2.5 text-sm font-bold text-red-600 transition hover:bg-red-50">
          Se déconnecter
        </button>
      </form>
    </section>
  </div>
@end