{{--
|--------------------------------------------------------------------------
| pages/auth/login.edge : connexion
|--------------------------------------------------------------------------
| Routes : GET /login (login.show)  et  POST /login (login.store)
|
| ERREURS GÉRÉES :
|  - Champs invalides (e-mail mal écrit, champ vide) -> sous chaque champ (ui.input)
|  - Mauvais e-mail / mot de passe -> encadré rouge en haut du formulaire,
|    via @error('E_INVALID_CREDENTIALS') (erreur levée par verifyCredentials)
| CHARGEMENT : data-loading + loadingText sur le bouton.
--}}
@layouts.auth({
  title: 'Connexion',
  asideTitle: 'Connectez-vous, et discutez en toute sécurité.',
  asideText: 'Une messagerie fluide et sécurisée, conçue pour les apprenants de Kadea.'
})
  <h1 class="mb-8 text-center font-display text-2xl font-bold">Connexion</h1>

  {{-- Erreur "identifiants incorrects" --}}
  @error('E_INVALID_CREDENTIALS')
    <div class="mb-4">
      @ui.alert({ type: 'error' })
        {{ $message }}
      @end
    </div>
  @end

  {{-- novalidate : on laisse le SERVEUR valider (VineJS) pour garder des messages cohérents --}}
  <form method="POST" action="{{ route('login.show') }}" data-loading novalidate class="space-y-4">
    {{ csrfField() }}

    @!ui.input({ name: 'email', label: 'E-mail', type: 'email', autocomplete: 'email', required: true })
    @!ui.input({ name: 'password', label: 'Mot de passe', type: 'password', autocomplete: 'current-password', required: true })

    @ui.button({ loadingText: 'Connexion...', class: 'w-full' })
      Se connecter
    @end
  </form>

  <div class="mt-4 flex items-center justify-between text-xs text-brand-600">
    {{-- TODO : brancher la page "mot de passe oublié" quand elle existera --}}
    <a href="#" class="hover:underline">Mot de passe oublié ?</a>
    <a href="{{ route('register.store') }}" class="hover:underline">Créer un compte</a>
  </div>
@end
