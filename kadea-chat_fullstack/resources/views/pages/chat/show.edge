{{--
|--------------------------------------------------------------------------
| pages/chat/show.edge : une discussion ouverte
|--------------------------------------------------------------------------
| Routes : GET /chat/:id (chat.show)  et  POST /chat/:id/messages (messages.store)
|
| Ordinateur : liste à gauche + conversation à droite.
| Mobile     : uniquement la conversation (view = 'conversation'), avec flèche retour.
|
| Données : conversations (tableau), conversation (objet), messages (tableau)
--}}
@layouts.app({ title: conversation.title, view: 'conversation' })
  @slot('sidebar')
    @!chat.sidebar({ conversations: conversations, activeId: conversation.id })
  @end

  @!chat.conversationHeader({ conversation: conversation })

  {{-- Zone des messages. id="messages" -> app.js la fait défiler tout en bas. --}}
  <div
  id="messages"
  data-conversation-id="{{ conversation.id }}"
  data-current-user-id="{{ currentUserId }}"
  data-is-group="{{ conversation.isGroup }}"
  class="flex-1 space-y-3 overflow-y-auto px-4 py-4"
  aria-live="polite"
  >

    {{-- SQUELETTE : affiché par showSkeleton('messages') pendant un fetch --}}
    <div data-skeleton="messages" class="hidden space-y-3">
      @!chat.messageSkeleton()
      @!chat.messageSkeleton({ mine: true })
      @!chat.messageSkeleton()
    </div>

    @each(message in messages)
      @!chat.messageBubble({ message: message, isGroup: conversation.isGroup })
    @else
      {{-- CAS VIDE : conversation sans aucun message --}}
      {{-- ajout de data empty state pour que javascript puisse le retirer quand le premier message arrive --}}
      <div data-empty-state class="flex h-full items-center justify-center text-center text-sm text-brand-950/70">
        Aucun message pour l'instant. Dis bonjour !
      </div>
    @end
  </div>

  @!chat.messageForm({ conversationId: conversation.id })
@end
