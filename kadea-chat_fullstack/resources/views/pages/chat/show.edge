{{--
|--------------------------------------------------------------------------
| pages/chat/show.edge : une discussion ouverte
|--------------------------------------------------------------------------
| Routes : GET /chat/:id (chat.show)  et  POST /chat/:id/messages (messages.store)
|
| Ordinateur : liste à gauche + conversation à droite.
| Mobile     : uniquement la conversation (view = 'conversation'), avec flèche retour.
|
| Données : conversations (tableau), conversation (objet), messages (tableau)
--}}
@layouts.app({ title: conversation.title, view: 'conversation' })
  @slot('sidebar')
    @!chat.sidebar({ conversations: conversations, activeId: conversation.id })
  @end

  @!chat.conversationHeader({ conversation: conversation })

  {{-- Zone des messages. id="messages" -> app.js la fait défiler tout en bas. --}}
  <div
    id="messages"
    data-conversation-id="{{ conversation.id }}"
    data-current-user-id="{{ currentUserId }}"
    data-is-group="{{ conversation.isGroup }}"
    class="flex-1 space-y-3 overflow-y-auto px-4 py-4"
    aria-live="polite">

    {{-- SQUELETTE : affiché par showSkeleton('messages') pendant un fetch --}}
    <div data-skeleton="messages" class="hidden space-y-3">
      @!chat.messageSkeleton()
      @!chat.messageSkeleton({ mine: true })
      @!chat.messageSkeleton()
    </div>

    @each(message in messages)
      @!chat.messageBubble({ message: message, isGroup: conversation.isGroup, conversationId: conversation.id  })
    @else
      {{-- CAS VIDE : conversation sans aucun message --}}
      {{-- ajout de data empty state pour que javascript puisse le retirer quand le premier message arrive --}}
      <div data-empty-state class="flex h-full items-center justify-center text-center text-sm text-ink/70">
        Aucun message pour l'instant. Dis bonjour !
      </div>
    @end
  </div>

  @!chat.messageForm({ conversationId: conversation.id })

  {{-- NOUVEAU : la fenêtre de confirmation de suppression (UNE seule pour toute la page).
       - Invisible tant qu'app.js n'appelle pas showModal().
       - m-auto : la centre à l'écran (Tailwind retire la marge par défaut des balises).
       - backdrop:bg-black/50 : assombrit tout le reste de la page derrière la fenêtre. --}}
  <dialog id="delete-dialog" aria-labelledby="delete-dialog-title"
    class="m-auto w-[min(90vw,22rem)] rounded-xl border border-line bg-surface p-5 text-ink shadow-xl backdrop:bg-black/50">
    <h2 id="delete-dialog-title" class="font-display text-base font-bold">Supprimer ce message ?</h2>
    <p class="mt-2 text-sm text-muted">Il sera remplacé par « Ce message a été supprimé » pour tout le monde.</p>

    {{-- method="dialog" : cliquer sur un bouton FERME la fenêtre, sans rien envoyer au serveur.
         La "value" du bouton cliqué est retenue dans dialog.returnValue ('cancel' ou 'confirm').
         autofocus sur Annuler : si on appuie sur Entrée par réflexe, on ne supprime rien. --}}
    <form method="dialog" class="mt-5 flex justify-end gap-2">
      <button value="cancel" autofocus class="rounded-lg border border-line px-4 py-2 text-sm hover:bg-page">
        Annuler
      </button>
      <button value="confirm" class="rounded-lg bg-danger px-4 py-2 text-sm font-bold text-white hover:opacity-90 dark:text-brand-950">
        Supprimer
      </button>
    </form>
  </dialog>
@end