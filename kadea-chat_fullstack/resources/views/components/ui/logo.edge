{{--
| ui/logo.edge : le logo Kadea Chat (rond orange + bulle de discussion)
| Props :
|   size      -> 'sm' | 'md' | 'xl'  (défaut : md)
|   withText  -> afficher "kadea.chat" sous le rond (défaut : true)
|   textClass -> couleur du texte (défaut : text-accent)
--}}
@let(size = $props.get('size') || 'md')
@let(withText = $props.get('withText') !== false)
@let(sizes = { sm: 'h-9 w-9', md: 'h-14 w-14', xl: 'h-20 w-20' })
<span class="inline-flex flex-col items-center gap-1 text-accent">
  <svg class="{{ sizes[size] }}" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="2.5" />
    <path d="M24 14c-6.1 0-11 4-11 9 0 2.4 1.1 4.6 3 6.2L15 34l5.3-2.4c1.1.3 2.4.4 3.7.4 6.1 0 11-4 11-9s-4.9-9-11-9z" fill="currentColor" />
    <circle cx="19" cy="23" r="1.5" fill="white" />
    <circle cx="24" cy="23" r="1.5" fill="white" />
    <circle cx="29" cy="23" r="1.5" fill="white" />
  </svg>
  @if(withText)
    <span class="font-display {{ size === 'xl' ? 'text-xl' : 'text-[10px]' }} font-bold {{ $props.get('textClass') || 'text-accent' }}">kadea.chat</span>
  @end
</span>
