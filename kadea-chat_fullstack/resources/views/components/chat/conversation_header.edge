{{--
| chat/conversation_header.edge : bandeau en haut de la conversation
| Props : conversation { title, avatarUrl, isOnline, statusText, isGroup, memberCount }
|
| La flèche "retour" n'existe que sur mobile (md:hidden) : elle ramène à la liste.
--}}
@let(c = $props.get('conversation'))
<header class="flex items-center gap-3 border-b border-line bg-surface px-4 py-3">

  <a href="{{ route('chat.index') }}" class="-ml-1 rounded-lg p-1 text-ink md:hidden" aria-label="Retour aux discussions">
    @!ui.icon({ name: 'back', class: 'h-6 w-6' })
  </a>

  @!ui.avatar({ name: c.title, url: c.avatarUrl, size: 'md' })

  {{-- flex-1 : ce bloc prend toute la place restante, ce qui repousse le lien "Membres" à droite --}}
  <div class="min-w-0 flex-1">
    <h1 class="truncate font-display text-base font-bold">{{ c.title }}</h1>
    @if(c.isGroup)
      <p class="text-xs text-muted">{{ c.memberCount }} membres</p>
    @elseif(c.isOnline)
      <p class="text-xs font-medium text-green-600">en ligne</p>
    @else
      <p class="text-xs text-muted">{{ c.statusText || '' }}</p>
    @end
  </div>

  {{-- Visible seulement dans un groupe --}}
  @if(c.isGroup)
    <a href="{{ route('groups.members', { id: c.id }) }}" class="shrink-0 rounded-lg px-3 py-1.5 text-xs font-bold text-link hover:bg-brand-400/20">
      Membres
    </a>
  @end
</header>
