{{--
| chat/conversation_skeleton.edge : fausse ligne grise "en train de charger"
| "animate-pulse" fait clignoter doucement les blocs gris (classe Tailwind).
--}}
<div class="flex animate-pulse items-center gap-3 px-3 py-2.5" aria-hidden="true">
  <div class="h-11 w-11 shrink-0 rounded-full bg-white/15"></div>
  <div class="flex-1 space-y-2">
    <div class="h-3 w-1/2 rounded bg-white/15"></div>
    <div class="h-2.5 w-3/4 rounded bg-white/10"></div>
  </div>
</div>
